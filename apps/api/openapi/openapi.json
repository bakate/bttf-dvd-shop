{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The API is running.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ],
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Check API health",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/cart/price": {
      "post": {
        "operationId": "CartPriceController_price",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "basket"
                ],
                "properties": {
                  "basket": {
                    "type": "string",
                    "description": "The cart as plain text, one movie title per line.",
                    "example": "Back to the Future 1\nBack to the Future 2\nLa chèvre"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The cart price.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "total",
                    "currency"
                  ],
                  "properties": {
                    "total": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Total price of the cart, in euro cents.",
                      "example": 4700
                    },
                    "currency": {
                      "type": "string",
                      "enum": [
                        "EUR"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The cart cannot be priced."
          }
        },
        "summary": "Price a cart",
        "tags": [
          "Cart"
        ]
      }
    }
  },
  "info": {
    "title": "BTTF DVD Shop API",
    "description": "Prices Back to the Future DVD carts.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Health",
      "description": ""
    },
    {
      "name": "Cart",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {}
  }
}
