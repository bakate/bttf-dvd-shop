{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The API is running.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ],
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Check API health",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/cart/price": {
      "post": {
        "operationId": "CartPriceController_price",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "basket"
                ],
                "properties": {
                  "basket": {
                    "type": "string",
                    "description": "The cart as plain text, one movie title per line.",
                    "example": "Back to the Future 1\nBack to the Future 2\nLa chèvre"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The cart price.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "lines",
                    "sagaSubtotal",
                    "distinctSagaEpisodeCount",
                    "discountRate",
                    "discount",
                    "regularSubtotal",
                    "total",
                    "currency"
                  ],
                  "properties": {
                    "lines": {
                      "type": "array",
                      "description": "One line per title, in the order each title first appears in the basket.",
                      "items": {
                        "type": "object",
                        "required": [
                          "title",
                          "kind",
                          "unitPrice",
                          "quantity"
                        ],
                        "properties": {
                          "title": {
                            "type": "string",
                            "description": "The title as first read, with its whitespace collapsed.",
                            "example": "Back to the Future 1"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "saga-episode",
                              "regular-movie"
                            ]
                          },
                          "unitPrice": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Unit price of the movie, in euro cents.",
                            "example": 1500
                          },
                          "quantity": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Copies of the title in the cart, matched ignoring case and whitespace.",
                            "example": 2
                          }
                        }
                      }
                    },
                    "sagaSubtotal": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Saga episodes before discount, in euro cents.",
                      "example": 3000
                    },
                    "distinctSagaEpisodeCount": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Number of different saga episodes in the cart.",
                      "example": 2
                    },
                    "discountRate": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "nullable": true,
                      "description": "Rate of the discount tier applied to the saga subtotal, or null when the cart reaches no tier.",
                      "example": 0.1
                    },
                    "discount": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Discount taken off the saga subtotal, in euro cents.",
                      "example": 300
                    },
                    "regularSubtotal": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Regular movies, never discounted, in euro cents.",
                      "example": 2000
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Total price of the cart, in euro cents.",
                      "example": 4700
                    },
                    "currency": {
                      "type": "string",
                      "enum": [
                        "EUR"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The cart cannot be priced."
          }
        },
        "summary": "Price a cart",
        "tags": [
          "Cart"
        ]
      }
    }
  },
  "info": {
    "title": "BTTF DVD Shop API",
    "description": "Prices Back to the Future DVD carts.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Health",
      "description": ""
    },
    {
      "name": "Cart",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {}
  }
}
